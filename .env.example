# =============================================================================
# SynthNews — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Only the REQUIRED section must be set to get started.
# All other sections are optional and unlock advanced features.
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# These 3 must be set for the app to start in production.

# PostgreSQL password for the Docker Compose database
DB_PASSWORD=thay-bang-mat-khau-manh

# Admin token — protects /admin, /sources, and all write APIs.
# MUST be a long random string in production; the server refuses weak tokens.
ADMIN_TOKEN=thay-bang-chuoi-ngau-nhien-dai

# Public URL of your site (used for Open Graph meta tags, share links, CORS)
PUBLIC_SITE_URL=https://your-domain.example.com
CORS_ORIGIN=https://your-domain.example.com

# ── AI PROVIDER ──────────────────────────────────────────────────────────────
# At least ONE AI provider must be configured in /admin after first deploy.
# Without it, articles will be scraped but never summarized.
# You can also set default keys here so the provider is pre-filled:
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...

# ── SCRAPER TUNING ───────────────────────────────────────────────────────────
# These control how often and how much the scraper fetches.
# The defaults work well for a personal instance; tune if needed.

SCRAPE_INTERVAL_HOURS=1          # How often to generate the daily digest (hours)
MAX_ARTICLES_PER_SOURCE=20       # Max new articles per source per scrape run
MAX_AI_CALLS_PER_RUN=30          # Max articles summarized per cron tick
DIGEST_ARTICLE_LIMIT=500          # Max articles included in each digest
MIN_ARTICLE_TEXT_LENGTH=500       # Min characters to keep an article (shorter = discarded)
FETCH_PER_DOMAIN_DELAY_MS=10000   # Min delay between requests to the same domain (ms)
MAX_ARTICLE_FETCH_JOBS_PER_RUN=30 # Max fetch jobs processed per queue run
ARTICLE_BROWSER_FETCH_TIMEOUT_MS=30000  # Timeout for browser-based fetches

# ── FORUM SCRAPING ───────────────────────────────────────────────────────────
VOZ_MAX_THREAD_PAGES=15           # Max pages to crawl per VOZ thread
FORUM_MAX_COMMENTS=70             # Max comments extracted per forum thread
FORUM_RAW_CONTENT_MAX_LENGTH=80000  # Max character length of raw forum content
FORUM_MIN_COMMENTS=10             # Min comments required to keep a VOZ article
REDDIT_COMMENT_LIMIT=30           # Max Reddit comments retained
REDDIT_COMMENT_DEPTH=3            # Max depth of Reddit reply tree
REDDIT_MIN_COMMENTS=5             # Min comments required to keep a Reddit article

# ── REDDIT AUTH (optional) ───────────────────────────────────────────────────
# Set these to use Reddit OAuth for richer comment data.
# Without them, Reddit scraping falls back to RSS + public endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ── PROXY WORKERS (optional) ─────────────────────────────────────────────────
# Cloudflare Worker URLs for bypassing datacenter IP blocks.
# Deploy the worker .js files from the repo root to Cloudflare Workers first.
# Generic proxy — used for blocked news sites (Yahoo, NYT, etc.)
WORKER_PROXY_URL=
WORKER_PROXY_TOKEN=
WORKER_PROXY_SKIP_DOMAINS=        # Hosts that should NOT use the worker proxy (comma-separated)

# Reddit-specific proxy
REDDIT_PROXY_URL=

# ── SCRAPLING SIDECAR (optional) ─────────────────────────────────────────────
# Python-based stealth browser that bypasses Cloudflare anti-bot challenges.
# Used automatically when native HTTP fetch is blocked.
# In Docker Compose: http://scrapling:8000
# Local dev:          http://localhost:8000
SCRAPLING_SERVICE_URL=
SCRAPLING_SERVICE_TOKEN=thay-bang-chuoi-ngau-nhien-dai-cho-sidecar
SCRAPLING_TIMEOUT_MS=60000

# Residential/rotating proxy for HARD-BLOCKED domains (routed via Scrapling).
# Only used for hosts listed in SCRAPLING_PROXY_DOMAINS to save bandwidth.
SCRAPLING_PROXY_URL=
SCRAPLING_PROXY_DOMAINS=reuters.com,bloomberg.com

# Vietnam residential proxy for GEO-BLOCKED .vn sites that 403 non-VN IPs.
# A DIFFERENT axis from SCRAPLING_PROXY_URL above — geo-block vs anti-bot.
VN_PROXY_URL=
VN_PROXY_DOMAINS=qdnd.vn

# ── REUTERS / DATADOME ───────────────────────────────────────────────────────
# Reuters uses DataDome anti-bot protection. The preferred path is a warmed
# browser cookie + residential proxy. See README for the full runbook.
REUTERS_COOKIE_HEADER=
REUTERS_COOKIE_HEADER_B64=
REUTERS_COOKIE_HEADER_B64_FILE=/app/runtime/reuters-cookie/reuters-cookie.b64
FETCH_COOKIE_REUTERS_COM=
FETCH_COOKIE_REUTERS_COM_B64=
FETCH_COOKIE_REUTERS_COM_B64_FILE=
REUTERS_COOKIE_REFRESH_INTERVAL_SECONDS=21600
REUTERS_COOKIE_REFRESH_COOLDOWN_SECONDS=900
REUTERS_COOKIE_VERIFY_URL=https://www.reuters.com/world/

# Domains known to use DataDome (triggers a different hosted-fetch chain order)
DATADOME_DOMAINS=reuters.com,bloomberg.com

# ── HOSTED FETCH CHAIN (optional, paid) ─────────────────────────────────────
# Last-resort fallback when all self-hosted tiers are blocked by anti-bot.
# With ANY key set here, blocked hosts auto-escalate to the paid chain.
# A provider with no key or exceeding its daily cap is automatically skipped.
# Normal hosts order:    ScrapingAnt datacenter → Scrape.do → Geekflare → ScrapeOps → Firecrawl
# DataDome hosts order:  Geekflare → Scrape.do → ScrapeOps → Firecrawl → ScrapingAnt residential
SCRAPINGANT_API_KEY=
SCRAPINGANT_MAX_PER_DAY=300
SCRAPINGANT_RESIDENTIAL_MAX_PER_DAY=15
SCRAPEDO_API_KEY=
SCRAPEDO_MAX_PER_DAY=30
GEEKFLARE_API_KEY=
GEEKFLARE_MAX_PER_DAY=100
SCRAPEOPS_API_KEY=
SCRAPEOPS_MAX_PER_DAY=30
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_MAX_PER_DAY=30

# Hosts that should proactively try the hosted chain (comma-separated)
HOSTED_FETCH_DOMAINS=reuters.com,bloomberg.com

# ── archive.today PAYWALL FALLBACK ─────────────────────────────────────────────
# Domains where short article content (< 3000 chars) triggers an archive.today
# snapshot lookup to recover the full text behind hard paywalls (WSJ, FT,
# Economist, Bloomberg). Free; works best for older/popular articles that have
# already been archived.
PAYWALL_ARCHIVE_DOMAINS=wsj.com,bloomberg.com

# ── accessarticlenow.com PAYWALL FALLBACK ──────────────────────────────────────
# Third-party service that returns full-article HTML for paywalled sites.
# Runs after archive.today. Currently confirmed working: bloomberg.com.
# Not working on free tier: reuters.com (needs BrightData KYC), wsj.com,
# nytimes.com. Add domains as the service expands coverage.
ACCESSARTICLE_DOMAINS=bloomberg.com

# ── BLOCKLIST ────────────────────────────────────────────────────────────────
# Domains to skip entirely during scraping (comma-separated).
# Overrides the built-in default list if set.
BLOCKED_DOMAINS=

# ── IMAGE PROXY ──────────────────────────────────────────────────────────────
# Server-side image proxy cache size limit
IMAGE_CACHE_MAX_MB=200
