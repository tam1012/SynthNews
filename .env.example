# Database
DB_PASSWORD=thay-bang-mat-khau-manh

# Admin
ADMIN_TOKEN=thay-bang-chuoi-ngau-nhien-dai

# Public URL (used for Open Graph meta tags and share links)
PUBLIC_SITE_URL=https://your-domain.example.com

# Scraper
SCRAPE_INTERVAL_HOURS=1
MAX_ARTICLES_PER_SOURCE=20
MAX_AI_CALLS_PER_RUN=30
DIGEST_ARTICLE_LIMIT=100
VOZ_MAX_THREAD_PAGES=4
FORUM_MAX_COMMENTS=40
FORUM_RAW_CONTENT_MAX_LENGTH=60000
REDDIT_COMMENT_LIMIT=30
REDDIT_COMMENT_DEPTH=3

# Reddit OAuth (optional - enables full comment access)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Reddit Proxy (optional - Cloudflare Worker URL for bypassing IP block)
# Deploy reddit-proxy-worker.js to Cloudflare Workers, then set the URL here
REDDIT_PROXY_URL=

# Browser host proxy (optional - Docker app to host GUI Chromium proxy)
# BROWSER_PROXY_URL=http://host.docker.internal:8788/fetch
BROWSER_PROXY_URL=
# Backward-compatible alias for VOZ/browser proxy.
VOZ_PROXY_URL=
# Extra article hosts allowed through the host browser proxy, comma-separated.
BROWSER_PROXY_ALLOWED_HOSTS=

# Scrapling sidecar (anti-bot fetching service)
# In Docker: http://scrapling:8000 | Local: http://localhost:8000
SCRAPLING_SERVICE_URL=
SCRAPLING_TIMEOUT_MS=60000

# Residential/rotating proxy for HARD-BLOCKED domains only (routed via Scrapling).
# Leave empty to disable. Format: http://user:pass@host:port
# SCRAPLING_PROXY_DOMAINS is the allowlist of hostnames that use the proxy, so
# you never spend paid proxy bandwidth on sites that work from the VPS IP.
SCRAPLING_PROXY_URL=
SCRAPLING_PROXY_DOMAINS=reuters.com,bloomberg.com

# Firecrawl hosted fallback (last resort for DataDome/Cloudflare sites).
# Free tier ~500-1000 credits. With a key set, ANY host blocked by anti-bot
# auto-escalates to Firecrawl; FIRECRAWL_DOMAINS additionally forces those hosts
# to try Firecrawl proactively. FIRECRAWL_MAX_PER_DAY caps spend (rolling 24h).
# Get a key at https://firecrawl.dev — leave empty to disable.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_DOMAINS=reuters.com,bloomberg.com
FIRECRAWL_MAX_PER_DAY=300

# Blocked domains (comma-separated, skip fetch for these domains)
# Overrides the built-in default list if set
BLOCKED_DOMAINS=


# CORS (set to your public domain)
CORS_ORIGIN=https://your-domain.example.com
