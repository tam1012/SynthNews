# =============================================================================
# SynthNews — Local Development (server/.env)
# =============================================================================
# Copy to server/.env for local backend dev without Docker.
# The root .env.example covers Docker/production deployment.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Uses port 5433 to avoid conflicts with a local PostgreSQL on 5432.
# The docker run command in README maps 5433→5432 inside the container.
DATABASE_URL=postgresql://newstamhv:newstamhv@localhost:5433/newstamhv

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=dev-admin-token-change-this

# ── Public URL ───────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://synthnews.local
CORS_ORIGIN=https://synthnews.local

# ── Scraper ──────────────────────────────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=1
MAX_ARTICLES_PER_SOURCE=20
MAX_AI_CALLS_PER_RUN=30
SUMMARY_CONCURRENCY=3
DIGEST_ARTICLE_LIMIT=500
MIN_ARTICLE_TEXT_LENGTH=500

# ── Forum ────────────────────────────────────────────────────────────────────
VOZ_MAX_THREAD_PAGES=4
FORUM_MAX_COMMENTS=40
FORUM_RAW_CONTENT_MAX_LENGTH=60000
REDDIT_COMMENT_LIMIT=30
REDDIT_COMMENT_DEPTH=3

# ── Reddit (optional) ────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_PROXY_URL=

# ── Proxy Workers (optional) ─────────────────────────────────────────────────
WORKER_PROXY_URL=
WORKER_PROXY_TOKEN=
REDDIT_PROXY_URL=

# ── Scrapling sidecar (optional for local dev) ───────────────────────────────
# When running full docker compose: http://scrapling:8000
# When running only the sidecar locally: http://localhost:8000
SCRAPLING_SERVICE_URL=
SCRAPLING_SERVICE_TOKEN=change-me-local-sidecar-token
SCRAPLING_TIMEOUT_MS=60000

# ── Blocklist ────────────────────────────────────────────────────────────────
BLOCKED_DOMAINS=
